<mujoco model="panda_suction_gripper">
    <asset>
        <mesh name="cobot_pump_visual" file="../meshes/cobot_pump/visual/cobot_pump.obj" />
        <mesh name="cobot_pump_collision" file="../meshes/cobot_pump/collision/cobot_pump.stl" />
        
        <material name="panda_off_white" rgba="0.901961 0.921569 0.929412 1" />
        <material name="panda_black" rgba="0.25 0.25 0.25 1" />
    </asset>
    
    <actuator>
        <general name="suction" joint="joint_suction" ctrllimited="true" ctrlrange="-1 1" />
    </actuator>

    <worldbody>
        <body name="gripper_base" pos="0 0 0">
            <joint name="joint_suction" type="slide" axis="0 0 1" limited="true" range="0 0.01" damping="0.1" />

            <body name="cobot_pump" pos="0 0 0.107">
                <inertial pos="0 0 0.063" mass="1.01" diaginertia="0.001 0.001 0.001" />
                <geom type="mesh" mesh="cobot_pump_visual" material="panda_off_white" />
                <geom type="mesh" mesh="cobot_pump_collision" group="0" name="geo_snout" />

                <!-- Robosuite GripperModel expects a body named 'eef' to exist -->
                <body name="eef" pos="0 0 0.105" quat="1 0 0 0">
                    <site name="grip_site" pos="0 0 0" size="0.005 0.005 0.005" rgba="1 0 0 0.5" />
                    <site name="grip_cylinder" pos="0 0 0" size="0.005 0.005" rgba="0 1 0 0.2" type="cylinder" />
                    <!-- Match robosuite PandaGripper naming for ee wrench sensing -->
                    <site name="ft_frame" pos="0 0 0" size="0.001" rgba="0 0 0 0" />
                </body>
            </body>
        </body>
    </worldbody>

    <sensor>
        <force name="force_ee" site="ft_frame"/>
        <torque name="torque_ee" site="ft_frame"/>
    </sensor>

    <equality>
        <!--
        This weld is kept inactive by default. At runtime, the controller code
        retargets body2 to the contacted object body and sets relpose to the
        current relative pose, then toggles eq_active.
        -->
        <weld name="suction_constraint"
              body1="cobot_pump"
              body2="gripper_base"
              active="false"
              relpose="0 0 0 1 0 0 0"
              solref="0.02 1"
              solimp=".9 .95 .001"/>
    </equality>
</mujoco>