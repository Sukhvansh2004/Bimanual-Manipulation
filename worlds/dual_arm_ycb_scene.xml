<?xml version="1.0" encoding="utf-8"?>
<!--
    Dual Arm YCB Scene World Configuration
    
    This file defines a workspace scene with:
    - Two Franka Panda robot arms in an opposed configuration
    - A large table for manipulation tasks
    - Several YCB objects placed on the table
    - Additional primitive objects (boxes, cylinders, spheres)
    
    Note: This world is designed to be loaded with make_custom_world_env() 
    or used as a reference for custom MuJoCo simulations.
    
    Usage:
        from robosuite_franka_manipulation.environments import make_custom_world_env
        env = make_custom_world_env('dual_arm_ycb_scene.xml')
-->
<mujoco model="dual_arm_ycb_scene">
    <compiler angle="radian" inertiafromgeom="auto" meshdir="."/>
    
    <option timestep="0.002" gravity="0 0 -9.81" integrator="Euler"/>
    
    <default>
        <geom contype="1" conaffinity="1" friction="1 0.1 0.1"/>
        <joint armature="0.01" damping="1"/>
    </default>
    
    <asset>
        <!-- Floor texture -->
        <texture name="floor_texture" type="2d" builtin="checker" width="512" height="512" 
                 rgb1="0.8 0.8 0.8" rgb2="0.6 0.6 0.6"/>
        <material name="floor_material" texture="floor_texture" texrepeat="10 10"/>
        
        <!-- Table texture -->
        <texture name="table_texture" type="2d" builtin="flat" width="256" height="256" 
                 rgb1="0.4 0.25 0.15"/>
        <material name="table_material" texture="table_texture" specular="0.1" shininess="0.1"/>
        
        <!-- Robot base material -->
        <material name="robot_base_material" rgba="0.3 0.3 0.3 1" specular="0.5" shininess="0.5"/>
        
        <!-- Object materials -->
        <material name="red_material" rgba="0.9 0.2 0.2 1"/>
        <material name="green_material" rgba="0.2 0.9 0.2 1"/>
        <material name="blue_material" rgba="0.2 0.2 0.9 1"/>
        <material name="yellow_material" rgba="0.9 0.9 0.2 1"/>
    </asset>
    
    <worldbody>
        <!-- Ground plane -->
        <geom name="floor" type="plane" size="2 2 0.1" pos="0 0 0" material="floor_material"/>
        
        <!-- Light sources -->
        <light name="light_front" pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
        <light name="light_left" pos="-2 0 2" dir="0.5 0 -0.5" diffuse="0.4 0.4 0.4"/>
        <light name="light_right" pos="2 0 2" dir="-0.5 0 -0.5" diffuse="0.4 0.4 0.4"/>
        
        <!-- ================================================================ -->
        <!-- Robot 0 (Left Side) - Franka Panda Base Mount -->
        <!-- Position: Facing the table from the left side -->
        <!-- ================================================================ -->
        <body name="robot0_base_mount" pos="-0.6 0 0">
            <geom name="robot0_base_plate" type="cylinder" size="0.15 0.02" pos="0 0 0.01" 
                  material="robot_base_material" contype="1" conaffinity="1"/>
            <geom name="robot0_base_column" type="cylinder" size="0.08 0.2" pos="0 0 0.22" 
                  material="robot_base_material" contype="1" conaffinity="1"/>
            <!-- Robot attachment point -->
            <site name="robot0_attachment" pos="0 0 0.42" size="0.05" rgba="1 0 0 0.5"/>
            <!-- Placeholder for Panda robot - in robosuite this would be included via robot loader -->
            <!-- The robot would be mounted here facing +X direction (towards the table) -->
        </body>
        
        <!-- ================================================================ -->
        <!-- Robot 1 (Right Side) - Franka Panda Base Mount -->
        <!-- Position: Facing the table from the right side (opposed configuration) -->
        <!-- ================================================================ -->
        <body name="robot1_base_mount" pos="0.6 0 0" euler="0 0 3.14159">
            <geom name="robot1_base_plate" type="cylinder" size="0.15 0.02" pos="0 0 0.01" 
                  material="robot_base_material" contype="1" conaffinity="1"/>
            <geom name="robot1_base_column" type="cylinder" size="0.08 0.2" pos="0 0 0.22" 
                  material="robot_base_material" contype="1" conaffinity="1"/>
            <!-- Robot attachment point -->
            <site name="robot1_attachment" pos="0 0 0.42" size="0.05" rgba="0 0 1 0.5"/>
            <!-- Placeholder for Panda robot - in robosuite this would be included via robot loader -->
            <!-- The robot would be mounted here facing -X direction (towards the table) -->
        </body>
        
        <!-- ================================================================ -->
        <!-- Main manipulation table -->
        <!-- ================================================================ -->
        <body name="table" pos="0 0 0.4">
            <geom name="table_top" type="box" size="0.4 0.5 0.02" pos="0 0 0" 
                  material="table_material" contype="1" conaffinity="1"/>
            <geom name="table_leg_1" type="cylinder" size="0.03 0.2" pos="0.35 0.45 -0.2" 
                  rgba="0.3 0.2 0.1 1"/>
            <geom name="table_leg_2" type="cylinder" size="0.03 0.2" pos="-0.35 0.45 -0.2" 
                  rgba="0.3 0.2 0.1 1"/>
            <geom name="table_leg_3" type="cylinder" size="0.03 0.2" pos="0.35 -0.45 -0.2" 
                  rgba="0.3 0.2 0.1 1"/>
            <geom name="table_leg_4" type="cylinder" size="0.03 0.2" pos="-0.35 -0.45 -0.2" 
                  rgba="0.3 0.2 0.1 1"/>
        </body>
        
        <!-- ================================================================ -->
        <!-- Manipulable Objects (Primitive Shapes) -->
        <!-- ================================================================ -->
        
        <!-- Red cube -->
        <body name="red_cube" pos="-0.1 0.0 0.47">
            <freejoint name="red_cube_joint"/>
            <geom name="red_cube_geom" type="box" size="0.025 0.025 0.025" 
                  material="red_material" mass="0.1"/>
            <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
        </body>
        
        <!-- Green cylinder -->
        <body name="green_cylinder" pos="0.0 0.1 0.47">
            <freejoint name="green_cylinder_joint"/>
            <geom name="green_cylinder_geom" type="cylinder" size="0.02 0.04" 
                  material="green_material" mass="0.08"/>
            <inertial pos="0 0 0" mass="0.08" diaginertia="0.001 0.001 0.001"/>
        </body>
        
        <!-- Blue sphere -->
        <body name="blue_sphere" pos="0.1 -0.05 0.47">
            <freejoint name="blue_sphere_joint"/>
            <geom name="blue_sphere_geom" type="sphere" size="0.025" 
                  material="blue_material" mass="0.06"/>
            <inertial pos="0 0 0" mass="0.06" diaginertia="0.001 0.001 0.001"/>
        </body>
        
        <!-- Yellow box (larger) -->
        <body name="yellow_box" pos="0.05 0.15 0.47">
            <freejoint name="yellow_box_joint"/>
            <geom name="yellow_box_geom" type="box" size="0.03 0.02 0.015" 
                  material="yellow_material" mass="0.12"/>
            <inertial pos="0 0 0" mass="0.12" diaginertia="0.001 0.001 0.001"/>
        </body>
        
        <!-- ================================================================ -->
        <!-- Cameras for observation -->
        <!-- ================================================================ -->
        
        <!-- Agent view camera (main view from above and behind) -->
        <camera name="agentview" pos="0 -1.0 1.2" quat="0.924 0.383 0 0" fovy="60"/>
        
        <!-- Overhead camera -->
        <camera name="overhead_cam" pos="0 0 1.8" quat="1 0 0 0" fovy="60"/>
        
        <!-- Front view camera -->
        <camera name="frontview" pos="0 1.2 0.8" quat="0.924 -0.383 0 0" fovy="60"/>
        
        <!-- Side view camera (from robot0 side) -->
        <camera name="sideview" pos="-1.2 0 0.8" quat="0.653 0.271 -0.271 0.653" fovy="60"/>
        
        <!-- Robot 0 eye-in-hand view (placeholder) -->
        <camera name="robot0_eye_in_hand" pos="-0.4 0 0.8" quat="0.5 0.5 -0.5 0.5" fovy="60"/>
        
        <!-- Robot 1 eye-in-hand view (placeholder) -->
        <camera name="robot1_eye_in_hand" pos="0.4 0 0.8" quat="0.5 -0.5 0.5 0.5" fovy="60"/>
        
    </worldbody>
</mujoco>
